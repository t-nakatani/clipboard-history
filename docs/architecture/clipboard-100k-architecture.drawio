        <mxCell id="sc-app" value="macOSアプリ" style="swimlane;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="220" y="100" width="620" height="560" as="geometry"/></mxCell>
        <mxCell id="sc-ui" value="&lt;b&gt;AppKit UI&lt;/b&gt;&lt;br&gt;NSPanel / NSTableView / NSSearchField" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="sc-app"><mxGeometry x="30" y="70" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-bridge" value="&lt;b&gt;clipboard-ffi&lt;/b&gt;&lt;br&gt;UniFFI / ページDTO / コマンド" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="sc-app"><mxGeometry x="330" y="70" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-core" value="&lt;b&gt;clipboard-core&lt;/b&gt;&lt;br&gt;ドメイン型 / ポート / 純粋ポリシー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sc-app"><mxGeometry x="180" y="220" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-clip" value="&lt;b&gt;Swift Pasteboard Adapter&lt;/b&gt;&lt;br&gt;RunLoop監視 / raw UTI復元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="sc-app"><mxGeometry x="30" y="390" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-search" value="&lt;b&gt;QueryPlanner&lt;/b&gt;&lt;br&gt;core内の純粋分類ロジック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sc-app"><mxGeometry x="225" y="390" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-store" value="&lt;b&gt;clipboard-store&lt;/b&gt;&lt;br&gt;SQLite + FTS5 + CAS + GC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="sc-app"><mxGeometry x="420" y="390" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-pb" value="macOS Pasteboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="shape_layer"><mxGeometry x="940" y="120" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="sc-sqlite" value="履歴メタデータ&#xa;SQLite + FTS5" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="shape_layer"><mxGeometry x="940" y="300" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-payload" value="大容量Payload&#xa;Content Addressed Storage" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="shape_layer"><mxGeometry x="940" y="500" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="sc-rule" value="&lt;b&gt;不変条件&lt;/b&gt;&lt;br&gt;履歴本体を全件メモリに載せない&lt;br&gt;UIは50〜200件だけ保持&lt;br&gt;DBとpayloadの整合性はstoreが単独所有" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="1210" y="280" width="290" height="160" as="geometry"/></mxCell>
