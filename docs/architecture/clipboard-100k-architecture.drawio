        <mxCell id="sc-e8" edge="1" parent="edge_layer" source="sc-search" target="sc-store" value="query class" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
