        <mxCell id="cs-pb" value="NSPasteboard" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="100" width="180" height="760" as="geometry"/></mxCell>
