  </diagram>
  <diagram id="storage-concepts" name="4. Store・Search・Payloadの概念">
    <mxGraphModel adaptiveColors="auto" dx="1700" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="edge_layer" value="Edges" parent="0"/>
        <mxCell id="shape_layer" value="Shapes" parent="0"/>
        <mxCell id="ss-title" value="&lt;b&gt;clipboard-store内部：整合性を単独所有する3モジュール&lt;/b&gt;" style="text;html=1;fontSize=22;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="ss-storebox" value="clipboard-store::repository" style="swimlane;startSize=32;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="100" width="500" height="710" as="geometry"/></mxCell>
        <mxCell id="ss-repo" value="&lt;b&gt;HistoryRepository&lt;/b&gt;&lt;br&gt;insert / page / delete / count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ss-storebox"><mxGeometry x="130" y="50" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-tx" value="&lt;b&gt;WriteTransaction&lt;/b&gt;&lt;br&gt;file durable後にrow commit&lt;br&gt;削除+tombstoneは原子的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ss-storebox"><mxGeometry x="30" y="180" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="ss-pager" value="&lt;b&gt;CursorPager&lt;/b&gt;&lt;br&gt;keyset paging&lt;br&gt;read txはquery内で閉じる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ss-storebox"><mxGeometry x="270" y="180" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="ss-migrate" value="&lt;b&gt;Migrator / Recovery&lt;/b&gt;&lt;br&gt;user_version / quick_check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ss-storebox"><mxGeometry x="30" y="320" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-prune" value="&lt;b&gt;Maintenance&lt;/b&gt;&lt;br&gt;batch prune / checkpoint&lt;br&gt;incremental vacuum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ss-storebox"><mxGeometry x="270" y="320" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-db" value="SQLite&#xa;WAL + bounded cache&#xa;synchronous=NORMAL&#xa;auto_vacuum=INCREMENTAL" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ss-storebox"><mxGeometry x="150" y="490" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="ss-searchbox" value="clipboard-store::search" style="swimlane;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="620" y="100" width="450" height="710" as="geometry"/></mxCell>
        <mxCell id="ss-query" value="&lt;b&gt;QueryClass&lt;/b&gt;&lt;br&gt;coreのQueryPlannerが生成&lt;br&gt;limit + cursor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ss-searchbox"><mxGeometry x="115" y="50" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="ss-plan" value="&lt;b&gt;StoreQueryExecutor&lt;/b&gt;&lt;br&gt;schemaに対応するSQLを選択" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ss-searchbox"><mxGeometry x="115" y="200" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-fts" value="&lt;b&gt;TrigramIndex&lt;/b&gt;&lt;br&gt;FTS5による正確な部分一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ss-searchbox"><mxGeometry x="30" y="340" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="ss-short" value="&lt;b&gt;ShortQueryPath&lt;/b&gt;&lt;br&gt;1〜2文字はrecent範囲を走査" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ss-searchbox"><mxGeometry x="240" y="340" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="ss-result" value="&lt;b&gt;SearchPage&lt;/b&gt;&lt;br&gt;軽量row + highlight range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ss-searchbox"><mxGeometry x="115" y="510" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="ss-payloadbox" value="clipboard-store::payload" style="swimlane;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="1150" y="100" width="500" height="710" as="geometry"/></mxCell>
        <mxCell id="ss-hash" value="&lt;b&gt;PayloadHash&lt;/b&gt;&lt;br&gt;BLAKE3 content identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ss-payloadbox"><mxGeometry x="30" y="60" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-path" value="&lt;b&gt;PathLayout&lt;/b&gt;&lt;br&gt;ab/cd/hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ss-payloadbox"><mxGeometry x="270" y="60" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-put" value="&lt;b&gt;AtomicWriter&lt;/b&gt;&lt;br&gt;temp + fsync + rename" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ss-payloadbox"><mxGeometry x="30" y="210" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-gc" value="&lt;b&gt;GarbageCollector&lt;/b&gt;&lt;br&gt;tombstone + orphan scan&lt;br&gt;参照再確認後に物理削除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ss-payloadbox"><mxGeometry x="270" y="210" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ss-stream" value="&lt;b&gt;PayloadReader&lt;/b&gt;&lt;br&gt;要求時のみstream / bounded buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ss-payloadbox"><mxGeometry x="150" y="350" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="ss-files" value="payloads/&#xa;encoded originals&#xa;no eager decode" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ss-payloadbox"><mxGeometry x="150" y="510" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="ss-e1" edge="1" parent="edge_layer" source="ss-repo" target="ss-tx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e2" edge="1" parent="edge_layer" source="ss-repo" target="ss-pager" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e3" edge="1" parent="edge_layer" source="ss-tx" target="ss-db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e4" edge="1" parent="edge_layer" source="ss-pager" target="ss-db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e5" edge="1" parent="edge_layer" source="ss-migrate" target="ss-db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e6" edge="1" parent="edge_layer" source="ss-prune" target="ss-db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e7" edge="1" parent="edge_layer" source="ss-query" target="ss-plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e8" edge="1" parent="edge_layer" source="ss-plan" target="ss-fts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e9" edge="1" parent="edge_layer" source="ss-plan" target="ss-short" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e10" edge="1" parent="edge_layer" source="ss-fts" target="ss-result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ss-e11" edge="1" parent="edge_layer" source="ss-short" target="ss-result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
