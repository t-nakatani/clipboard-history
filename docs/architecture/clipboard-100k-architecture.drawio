  <diagram id="domain-concepts" name="3. CoreとClipboardの概念">
    <mxGraphModel adaptiveColors="auto" dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="edge_layer" value="Edges" parent="0"/>
        <mxCell id="shape_layer" value="Shapes" parent="0"/>
        <mxCell id="dc-title" value="&lt;b&gt;Swift Pasteboard Adapter と clipboard-core の主要概念&lt;/b&gt;" style="text;html=1;fontSize=22;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="dc-clipbox" value="Swift / AppKit Pasteboard Adapter" style="swimlane;startSize=32;fillColor=#f8cecc;strokeColor=#b85450;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="100" width="580" height="650" as="geometry"/></mxCell>
        <mxCell id="dc-monitor" value="&lt;b&gt;PasteboardMonitor&lt;/b&gt;&lt;br&gt;changeCountを単一スレッドで監視" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="dc-clipbox"><mxGeometry x="30" y="60" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="dc-reader" value="&lt;b&gt;TypeDiscovery&lt;/b&gt;&lt;br&gt;type identifierのみ&lt;br&gt;payloadはまだ読まない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="dc-clipbox"><mxGeometry x="310" y="60" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="dc-filter" value="&lt;b&gt;PayloadReader + DTO Mapper&lt;/b&gt;&lt;br&gt;accept後に保存UTIだけ読む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="dc-clipbox"><mxGeometry x="310" y="200" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="dc-writer" value="&lt;b&gt;PasteboardWriter&lt;/b&gt;&lt;br&gt;raw representationを復元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="dc-clipbox"><mxGeometry x="30" y="200" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="dc-snapshot" value="&lt;b&gt;ClipboardSnapshot&lt;/b&gt;&lt;br&gt;保存representationのみ&lt;br&gt;marker UTIなし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dc-clipbox"><mxGeometry x="170" y="350" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="dc-repr" value="&lt;b&gt;Representation&lt;/b&gt;&lt;br&gt;uti + bytes&lt;br&gt;原本は非正規化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dc-clipbox"><mxGeometry x="170" y="510" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="dc-corebox" value="clipboard-core" style="swimlane;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="760" y="100" width="760" height="650" as="geometry"/></mxCell>
        <mxCell id="dc-service" value="&lt;b&gt;HistoryService&lt;/b&gt;&lt;br&gt;capture / search / select / delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="dc-corebox"><mxGeometry x="270" y="50" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="dc-normalizer" value="&lt;b&gt;CaptureFilter + Normalizer&lt;/b&gt;&lt;br&gt;type-list policy / 検索テキスト" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="dc-corebox"><mxGeometry x="30" y="190" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="dc-fingerprint" value="&lt;b&gt;ClipIdentityPolicy&lt;/b&gt;&lt;br&gt;sorted UTI + bytes / versioned BLAKE3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="dc-corebox"><mxGeometry x="280" y="190" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="dc-retention" value="&lt;b&gt;RetentionPolicy&lt;/b&gt;&lt;br&gt;件数上限 / 容量上限 / pinned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="dc-corebox"><mxGeometry x="530" y="190" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="dc-candidate" value="&lt;b&gt;CaptureCandidate&lt;/b&gt;&lt;br&gt;原本snapshot + 派生metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dc-corebox"><mxGeometry x="150" y="350" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="dc-record" value="&lt;b&gt;ClipRecord&lt;/b&gt;&lt;br&gt;ID / title / timestamps / flags&lt;br&gt;payload参照のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dc-corebox"><mxGeometry x="400" y="350" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="dc-page" value="&lt;b&gt;HistoryPage&lt;/b&gt;&lt;br&gt;50〜200件 + cursor&lt;br&gt;UI境界の唯一の一覧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dc-corebox"><mxGeometry x="270" y="510" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="dc-e1" edge="1" parent="edge_layer" source="dc-monitor" target="dc-reader" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e2" value="type list" edge="1" parent="edge_layer" source="dc-reader" target="dc-normalizer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e2b" value="accept" edge="1" parent="edge_layer" source="dc-normalizer" target="dc-filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e3" edge="1" parent="edge_layer" source="dc-filter" target="dc-snapshot" value="保存UTIのbytesのみ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e4" edge="1" parent="edge_layer" source="dc-snapshot" target="dc-repr" value="1..n" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e5" edge="1" parent="edge_layer" source="dc-snapshot" target="dc-service" value="accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e6" edge="1" parent="edge_layer" source="dc-service" target="dc-normalizer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e7" edge="1" parent="edge_layer" source="dc-service" target="dc-fingerprint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e8" edge="1" parent="edge_layer" source="dc-service" target="dc-retention" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e9" edge="1" parent="edge_layer" source="dc-normalizer" target="dc-candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e10" edge="1" parent="edge_layer" source="dc-fingerprint" target="dc-candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e11" edge="1" parent="edge_layer" source="dc-candidate" target="dc-record" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e12" edge="1" parent="edge_layer" source="dc-record" target="dc-page" value="project" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dc-e13" edge="1" parent="edge_layer" source="dc-service" target="dc-writer" value="select" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="80"/><mxPoint x="20" y="80"/><mxPoint x="20" y="340"/></Array></mxGeometry></mxCell>
