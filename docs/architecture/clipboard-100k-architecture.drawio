        <mxCell id="cd-title" value="&lt;b&gt;クレート依存関係と境界&lt;/b&gt;" style="text;html=1;fontSize=22;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="cd-ui" value="&lt;b&gt;mac-app&lt;/b&gt;&lt;br&gt;Swift / AppKit&lt;br&gt;Rust crateではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="160" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="cd-bridge" value="&lt;b&gt;clipboard-ffi&lt;/b&gt;&lt;br&gt;UniFFI facade&lt;br&gt;Swift DTO・同期engine API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="shape_layer"><mxGeometry x="320" y="160" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="cd-core" value="&lt;b&gt;clipboard-core&lt;/b&gt;&lt;br&gt;ドメイン型・ポート&lt;br&gt;HistoryService / QueryPlanner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="shape_layer"><mxGeometry x="640" y="160" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="cd-clip" value="&lt;b&gt;Swift Pasteboard Adapter&lt;/b&gt;&lt;br&gt;AppKit / RunLoop&lt;br&gt;Rust crateではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="shape_layer"><mxGeometry x="320" y="340" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="cd-search" value="&lt;b&gt;clipboard-store&lt;/b&gt;&lt;br&gt;coreのポートを実装&lt;br&gt;整合性の単独所有者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="shape_layer"><mxGeometry x="980" y="210" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="cd-store" value="&lt;b&gt;store::search&lt;/b&gt;&lt;br&gt;FTS5 SQL / schema coupling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="980" y="390" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="cd-payload" value="&lt;b&gt;store::payload&lt;/b&gt;&lt;br&gt;stage / fsync / CAS / GC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="1240" y="390" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="cd-types" value="&lt;b&gt;core::domain + ports&lt;/b&gt;&lt;br&gt;独立types crateは作らない&lt;br&gt;FFI DTOはffiが所有" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="640" y="500" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="cd-ref" value="&lt;b&gt;arboard&lt;/b&gt;&lt;br&gt;参考実装のみ&lt;br&gt;runtime dependencyなし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="1280" y="80" width="210" height="90" as="geometry"/></mxCell>
