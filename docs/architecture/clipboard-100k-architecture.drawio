        <mxCell id="cs-core" value="clipboard-core policy / service" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=36;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="shape_layer"><mxGeometry x="540" y="100" width="180" height="760" as="geometry"/></mxCell>
        <mxCell id="cs-pay" value="clipboard-store::payload" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=36;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="shape_layer"><mxGeometry x="790" y="100" width="180" height="760" as="geometry"/></mxCell>
        <mxCell id="cs-db" value="clipboard-store::repository" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=36;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="shape_layer"><mxGeometry x="1040" y="100" width="180" height="760" as="geometry"/></mxCell>
        <mxCell id="cs-prune" value="Pruner" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=36;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="shape_layer"><mxGeometry x="1290" y="100" width="180" height="760" as="geometry"/></mxCell>
        <mxCell id="cs-ui" value="AppKit UI" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=36;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="shape_layer"><mxGeometry x="1540" y="100" width="180" height="760" as="geometry"/></mxCell>
        <mxCell id="cs-e1" value="1. changeCount" edge="1" parent="edge_layer" source="cs-mon" target="cs-pb" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.13;entryX=0.5;entryY=0.13;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e2" value="2. type identifiers only (no bytes)" edge="1" parent="edge_layer" source="cs-mon" target="cs-pb" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.20;entryX=0.5;entryY=0.20;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e3" value="3. evaluateCaptureTypes(types)" edge="1" parent="edge_layer" source="cs-mon" target="cs-core" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.28;entryX=0.5;entryY=0.28;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e4" value="4. accept / reject" edge="1" parent="edge_layer" source="cs-core" target="cs-mon" style="html=1;dashed=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.35;entryX=0.5;entryY=0.35;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e5" value="5. accept時のみ保存UTIのbytes" edge="1" parent="edge_layer" source="cs-mon" target="cs-pb" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.43;entryX=0.5;entryY=0.43;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e6" value="6. capture(storage representations)" edge="1" parent="edge_layer" source="cs-mon" target="cs-core" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.51;entryX=0.5;entryY=0.51;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e7" value="7. normalize + fingerprint" edge="1" parent="edge_layer" source="cs-core" target="cs-core" style="html=1;endArrow=classic;endSize=6;loopDirection=1;exitX=0.5;exitY=0.58;entryX=0.5;entryY=0.63;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e8" value="8. temp write → fsync → atomic rename" edge="1" parent="edge_layer" source="cs-core" target="cs-pay" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.67;entryX=0.5;entryY=0.67;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e9" value="9. durable後にrow commit / recopy=touch" edge="1" parent="edge_layer" source="cs-core" target="cs-db" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.75;entryX=0.5;entryY=0.75;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e10" value="10. enforce 10k/100k limit" edge="1" parent="edge_layer" source="cs-db" target="cs-prune" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.83;entryX=0.5;entryY=0.83;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-e11" value="11. newest row metadata only" edge="1" parent="edge_layer" source="cs-core" target="cs-ui" style="html=1;endArrow=classic;endSize=6;exitX=0.5;exitY=0.91;entryX=0.5;entryY=0.91;"><mxGeometry relative="1" y="-10" as="geometry"/></mxCell>
        <mxCell id="cs-note" value="reject時はpayload bytesを読まない。marker UTIはsnapshot / identityへ入れない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="540" y="890" width="680" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="search-sequence" name="6. 検索・ページング">
    <mxGraphModel adaptiveColors="auto" dx="1700" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="edge_layer" value="Edges" parent="0"/>
        <mxCell id="shape_layer" value="Shapes" parent="0"/>
        <mxCell id="sq-title" value="&lt;b&gt;検索・スクロール・選択のデータフロー&lt;/b&gt;" style="text;html=1;fontSize=22;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="sq-input" value="NSSearchField" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="180" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="sq-vm" value="&lt;b&gt;AppDelegate Search State&lt;/b&gt;&lt;br&gt;120ms debounce / generation ID&lt;br&gt;50 rows only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="shape_layer"><mxGeometry x="300" y="160" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="sq-bridge" value="&lt;b&gt;clipboard-ffi&lt;/b&gt;&lt;br&gt;search(query, mode, limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="shape_layer"><mxGeometry x="590" y="160" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="sq-core" value="&lt;b&gt;clipboard-core::HistoryService&lt;/b&gt;&lt;br&gt;QueryPlanner / ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="shape_layer"><mxGeometry x="880" y="160" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="sq-plan" value="&lt;b&gt;core::QueryPlanner&lt;/b&gt;&lt;br&gt;exact / prefix / trigram&lt;br&gt;short = recent 2,000 scan" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="shape_layer"><mxGeometry x="1170" y="150" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="sq-db" value="clipboard-store&#xa;専用actor + SQLite/FTS5" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="shape_layer"><mxGeometry x="1460" y="170" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="sq-table" value="NSTableView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="shape_layer"><mxGeometry x="300" y="430" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="sq-next" value="50件で打ち切り&lt;br&gt;全結果を保持しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="590" y="420" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="sq-select" value="選択・Paste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="shape_layer"><mxGeometry x="880" y="430" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="sq-payload" value="必要な1件だけ&#xa;payload読込・復元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="shape_layer"><mxGeometry x="1170" y="420" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="sq-budget" value="&lt;b&gt;メモリ境界&lt;/b&gt;&lt;br&gt;検索結果は50件で打ち切り&lt;br&gt;古いgenerationはUIへ反映しない&lt;br&gt;payloadは選択時だけ最大64MiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="shape_layer"><mxGeometry x="590" y="650" width="500" height="130" as="geometry"/></mxCell>
        <mxCell id="sq-e1" edge="1" parent="edge_layer" source="sq-input" target="sq-vm" value="query changed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e2" edge="1" parent="edge_layer" source="sq-vm" target="sq-bridge" value="new generation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e3" edge="1" parent="edge_layer" source="sq-bridge" target="sq-core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e4" edge="1" parent="edge_layer" source="sq-core" target="sq-plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e5" edge="1" parent="edge_layer" source="sq-plan" target="sq-db" value="indexed SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e6" edge="1" parent="edge_layer" source="sq-db" target="sq-vm" value="SearchPage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e7" edge="1" parent="edge_layer" source="sq-vm" target="sq-table" value="reload diff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e8" edge="1" parent="edge_layer" source="sq-table" target="sq-next" value="bounded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e10" edge="1" parent="edge_layer" source="sq-table" target="sq-select" value="Enter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sq-e11" edge="1" parent="edge_layer" source="sq-select" target="sq-payload" value="item ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="physical-data" name="7. データ配置とメモリ境界">
    <mxGraphModel adaptiveColors="auto" dx="1600" dy="950" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="950">
      <root>
        <mxCell id="0"/>
        <mxCell id="edge_layer" value="Edges" parent="0"/>
        <mxCell id="shape_layer" value="Shapes" parent="0"/>
        <mxCell id="pd-title" value="&lt;b&gt;10万件でもメモリを一定に保つ物理データ配置&lt;/b&gt;" style="text;html=1;fontSize=22;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="pd-memory" value="プロセスメモリ" style="swimlane;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="100" width="680" height="700" as="geometry"/></mxCell>
        <mxCell id="pd-uirows" value="&lt;b&gt;VisibleRows&lt;/b&gt;&lt;br&gt;50〜200件&lt;br&gt;軽量文字列・IDのみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="pd-memory"><mxGeometry x="30" y="70" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pd-coreheap" value="&lt;b&gt;Rust Core Heap&lt;/b&gt;&lt;br&gt;8MB目標&lt;br&gt;bounded buffers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="pd-memory"><mxGeometry x="245" y="70" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pd-sqlcache" value="&lt;b&gt;SQLite Page Cache&lt;/b&gt;&lt;br&gt;固定上限&lt;br&gt;mmap無制限禁止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="pd-memory"><mxGeometry x="460" y="70" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pd-stream" value="&lt;b&gt;Payload Buffer&lt;/b&gt;&lt;br&gt;1件をchunk読込&lt;br&gt;使用後即解放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="pd-memory"><mxGeometry x="135" y="250" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pd-thumb" value="&lt;b&gt;Thumbnail Cache&lt;/b&gt;&lt;br&gt;byte budget付きLRU&lt;br&gt;パネルclose時purge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="pd-memory"><mxGeometry x="355" y="250" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pd-never" value="&lt;b&gt;メモリに存在しないもの&lt;/b&gt;&lt;br&gt;全履歴配列&lt;br&gt;全検索結果&lt;br&gt;全画像デコード&lt;br&gt;無制限キャッシュ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="pd-memory"><mxGeometry x="190" y="460" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="pd-disk" value="ディスク" style="swimlane;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;html=1;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="820" y="100" width="700" height="700" as="geometry"/></mxCell>
        <mxCell id="pd-clips" value="clips&#xa;metadata → 長い列の順&#xa;normalized_text nullable&#xa;検索対象は初期16KiB上限" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="pd-disk"><mxGeometry x="40" y="70" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="pd-reps" value="representations&#xa;UTI + inline/ref&#xa;overflow実測で閾値決定" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="pd-disk"><mxGeometry x="260" y="70" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="pd-fts" value="FTS5 trigram&#xa;substring index&#xa;disk-backed" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="pd-disk"><mxGeometry x="480" y="70" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="pd-cas" value="WiscKey型value separation&#xa;payloads/ab/cd/hash&#xa;file先行commit / tombstone GC" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="pd-disk"><mxGeometry x="150" y="280" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="pd-wal" value="WAL / NORMAL&#xa;query-scoped reader&#xa;checkpoint starvation防止" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pd-disk"><mxGeometry x="430" y="280" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="pd-limits" value="&lt;b&gt;保持と空きpage回収&lt;/b&gt;&lt;br&gt;件数 + disk容量 / pinned保護&lt;br&gt;小batch prune&lt;br&gt;freelist → incremental vacuum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="pd-disk"><mxGeometry x="220" y="500" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="pd-e1" edge="1" parent="edge_layer" source="pd-uirows" target="pd-clips" value="page query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e2" edge="1" parent="edge_layer" source="pd-sqlcache" target="pd-clips" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e3" edge="1" parent="edge_layer" source="pd-sqlcache" target="pd-fts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e4" edge="1" parent="edge_layer" source="pd-stream" target="pd-cas" value="bounded read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e5" edge="1" parent="edge_layer" source="pd-thumb" target="pd-cas" value="on demand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e6" edge="1" parent="edge_layer" source="pd-clips" target="pd-reps" value="1:n" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e7" edge="1" parent="edge_layer" source="pd-clips" target="pd-fts" value="indexed text" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-e8" edge="1" parent="edge_layer" source="pd-reps" target="pd-cas" value="payload_hash" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="delete-gc-sequence" name="8. 削除・GC・クラッシュ整合性">
    <mxGraphModel adaptiveColors="auto" dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="edge_layer" value="Edges" parent="0"/>
        <mxCell id="shape_layer" value="Shapes" parent="0"/>
        <mxCell id="dg-title" value="&lt;b&gt;削除を同期pathから外し、壊れ方を孤児fileだけに限定する&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;" vertex="1" parent="shape_layer"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="dg-user" value="UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="80" y="90" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="dg-actor" value="Store Actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="360" y="90" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="dg-db" value="SQLite + GC Queue" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="680" y="80" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="dg-gc" value="Background GC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="1000" y="90" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="dg-files" value="Payload Files" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="shape_layer"><mxGeometry x="1320" y="80" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="dg-l1" style="html=1;strokeColor=#999999;dashed=1;endArrow=none;" edge="1" parent="edge_layer" source="dg-user"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="dg-l2" style="html=1;strokeColor=#999999;dashed=1;endArrow=none;" edge="1" parent="edge_layer" source="dg-actor"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="dg-l3" style="html=1;strokeColor=#999999;dashed=1;endArrow=none;" edge="1" parent="edge_layer" source="dg-db"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="dg-l4" style="html=1;strokeColor=#999999;dashed=1;endArrow=none;" edge="1" parent="edge_layer" source="dg-gc"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="dg-l5" style="html=1;strokeColor=#999999;dashed=1;endArrow=none;" edge="1" parent="edge_layer" source="dg-files"><mxGeometry relative="1" as="geometry"><mxPoint x="1410" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="dg-e1" value="1. delete clip" style="html=1;endArrow=classic;endSize=6;" edge="1" parent="edge_layer" source="dg-user" target="dg-actor"><mxGeometry relative="1" y="-230" as="geometry"/></mxCell>
        <mxCell id="dg-e2" value="2. row削除 + tombstone enqueueをcommit" style="html=1;endArrow=classic;endSize=6;" edge="1" parent="edge_layer" source="dg-actor" target="dg-db"><mxGeometry relative="1" y="-150" as="geometry"/></mxCell>
        <mxCell id="dg-e3" value="3. UIへ即時完了" style="html=1;endArrow=classic;endSize=6;dashed=1;" edge="1" parent="edge_layer" source="dg-actor" target="dg-user"><mxGeometry relative="1" y="-70" as="geometry"/></mxCell>
        <mxCell id="dg-e4" value="4. tombstone取得 / 孤児scan" style="html=1;endArrow=classic;endSize=6;" edge="1" parent="edge_layer" source="dg-gc" target="dg-db"><mxGeometry relative="1" y="30" as="geometry"/></mxCell>
        <mxCell id="dg-e5" value="5. 参照が0か再確認" style="html=1;endArrow=classic;endSize=6;dashed=1;" edge="1" parent="edge_layer" source="dg-db" target="dg-gc"><mxGeometry relative="1" y="110" as="geometry"/></mxCell>
        <mxCell id="dg-e6" value="6. payloadを物理削除" style="html=1;endArrow=classic;endSize=6;" edge="1" parent="edge_layer" source="dg-gc" target="dg-files"><mxGeometry relative="1" y="190" as="geometry"/></mxCell>
        <mxCell id="dg-note" value="&lt;b&gt;Crash invariant&lt;/b&gt;&lt;br&gt;file → fsync → rename → row commit のため、停止時に残り得るのはtempまたは未参照fileだけ。&lt;br&gt;dangling row → missing payload は許容しない。GCは冪等・再実行可能。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacing=10;" vertex="1" parent="shape_layer"><mxGeometry x="480" y="680" width="650" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
