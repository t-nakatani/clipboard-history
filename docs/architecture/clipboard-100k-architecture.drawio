  <diagram id="capture-sequence" name="5. コピー保存シーケンス">
    <mxGraphModel adaptiveColors="auto" dx="1800" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1000">
      <root>
